APP_NAME=Portfolio
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://gediminaspalsys.local:8443

# --- Local Docker environment ---
# Domain (used by nginx, certificates, Makefile)
DOMAIN=gediminaspalsys.local
# Host ports — change to avoid conflicts with other projects
HTTP_PORT=8080
SSL_PORT=8443
# Container name prefix
DOCKER_CONTAINER_PREFIX=portfolio

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=portfolio-mariadb
DB_PORT=3306
DB_DATABASE=portfolio
DB_USERNAME=root
DB_PASSWORD=toor

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# SSL certificate — filled automatically by `make update-ssl`
SSL_CERT=
SSL_KEY=
