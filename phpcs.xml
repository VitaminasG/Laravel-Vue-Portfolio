<?xml version="1.0"?>
<ruleset name="Laravel-Vue-Portfolio">

    <description>PSR-12 for the application's own PHP, ignoring generated and vendor code.</description>

    <!-- Scanned by default when phpcs is run with no path argument. -->
    <file>app</file>
    <file>config</file>
    <file>database</file>
    <file>routes</file>
    <file>tests</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/storage/*</exclude-pattern>
    <exclude-pattern>*/bootstrap/cache/*</exclude-pattern>
    <exclude-pattern>*/public/*</exclude-pattern>

    <!-- PHP_CodeSniffer scans .js and .css by default; this project lints
         those with ESLint instead. -->
    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg name="encoding" value="utf-8"/>
    <arg value="p"/>

    <rule ref="PSR12"/>

    <!--
        The original code mixed tabs with an oversized indent step. PSR-12
        mandates four spaces, which this enforces and phpcbf can apply.
    -->
    <rule ref="Generic.WhiteSpace.ScopeIndent">
        <properties>
            <property name="indent" value="4"/>
            <property name="tabIndent" value="false"/>
        </properties>
    </rule>

    <!--
        Laravel's stock scaffolding keeps a handful of files that PSR-12 would
        flag on naming or side effects; they are framework conventions, not
        defects in this project.
    -->
    <rule ref="PSR1.Files.SideEffects.FoundWithSymbols">
        <exclude-pattern>*/routes/*</exclude-pattern>
        <exclude-pattern>*/config/*</exclude-pattern>
        <exclude-pattern>*/database/migrations/*</exclude-pattern>
    </rule>

    <!--
        Migrations and seeders are resolved by file path, not by autoloaded
        namespace, so Laravel requires them to sit in the global namespace.
        PSR-12 would have us namespace them and break the framework.
    -->
    <rule ref="PSR1.Classes.ClassDeclaration.MissingNamespace">
        <exclude-pattern>*/database/migrations/*</exclude-pattern>
        <exclude-pattern>*/database/seeds/*</exclude-pattern>
    </rule>

    <!--
        Test methods are named test_what_it_does_when on purpose: PHPUnit reads
        the method name aloud when a test fails, and a snake_case sentence is
        far more useful there than testWhatItDoesWhen. This is the prevailing
        convention in the Laravel ecosystem.
    -->
    <rule ref="PSR1.Methods.CamelCapsMethodName.NotCamelCaps">
        <exclude-pattern>*/tests/*</exclude-pattern>
    </rule>

    <!--
        Test fixtures embed real User-Agent strings, which cannot be wrapped
        without changing what they assert, and the published config files come
        from the framework skeleton — rewrapping them only makes the next
        upgrade's diff noisier.
    -->
    <rule ref="Generic.Files.LineLength.TooLong">
        <exclude-pattern>*/tests/*</exclude-pattern>
        <exclude-pattern>*/config/*</exclude-pattern>
    </rule>

</ruleset>
