root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

# PSR-12 for PHP.
[*.php]
indent_size = 4

# Vue style guide default; keeps deeply nested templates readable.
[*.{js,vue,json,scss,css}]
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.{yml,yaml}]
indent_size = 2
